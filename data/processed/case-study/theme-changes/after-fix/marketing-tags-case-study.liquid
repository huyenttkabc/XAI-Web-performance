{%- comment -%}
  RQ4 case study (thesis): standard vendor snippets for Google Tag Manager, Google tag (GA4/Ads),
  Meta pixel and TikTok pixel, installed manually in the theme as many stores do.
  IDs are PLACEHOLDERS: the store does not run ads, so no real accounts are connected.
  RQ4 fix 2 (after baseline): the command queues (dataLayer, gtag, fbq, ttq) are still defined in <head>,
  so calls are buffered as before, but the vendor libraries are injected only after the window load event.
  Remove this render tag from layout/theme.liquid to uninstall.
{%- endcomment -%}

<script>
  // Command queues: defined immediately, exactly as in the vendor snippets
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-CS00RQ4XYZ');
  gtag('config', 'AW-100000004');

  !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window);
  fbq('init', '100000000000004');
  fbq('track', 'PageView');

  !function (w, t) {
    w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};ttq._deferredSrc=r+"?sdkid="+e+"&lib="+t};
    ttq.load('CS00RQ4CASESTUDY0000');
    ttq.page();
  }(window, 'ttq');

  // Vendor libraries: injected after the page has loaded, so they no longer compete with the LCP image
  window.addEventListener('load', function () {
    [
      'https://www.googletagmanager.com/gtm.js?id=GTM-CS00RQ4',
      'https://www.googletagmanager.com/gtag/js?id=G-CS00RQ4XYZ',
      'https://connect.facebook.net/en_US/fbevents.js',
      window.ttq._deferredSrc
    ].forEach(function (src) {
      var s = document.createElement('script');
      s.async = true;
      s.src = src;
      document.head.appendChild(s);
    });
  });
</script>
