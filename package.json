{
  "name": "xai-web-performance",
  "version": "0.1.0",
  "private": true,
  "description": "Detecting and explaining client-side Web performance degradation with Explainable ML",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "testbed": "node src/testbed/testbed-server.js",
    "pilot": "node src/run-pilot.js",
    "collect:wave1": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=1",
    "collect:wave2": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=2",
    "collect:wave3": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=3",
    "collect:wave4": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=4",
    "collect:wave5": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=5",
    "collect:retry": "node src/run-pilot.js --retry-errors --hard-cap-ms=300000",
    "sample:sites": "node scripts/build-main-study-site-sample.js",
    "reparse": "node scripts/reparse-raw-artifacts.js",
    "dictionary": "node scripts/build-data-dictionary.js",
    "reports": "npm run reparse && npm run dictionary && node scripts/build-fault-matrix-noise-report.js && node scripts/build-leakage-checklist.js && node scripts/build-dataset-qc-report.js && node scripts/build-eda-report.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "ml:setup": "python3.14 -m venv .venv && .venv/bin/pip install -q -r requirements-explanations.txt",
    "ml:train": ".venv/bin/python scripts/train_preliminary_models.py",
    "ml:learning-curve": ".venv/bin/python scripts/build_learning_curve.py",
    "ml:compare-size": ".venv/bin/python scripts/compare_training_set_size.py",
    "ml:rq1-rq2": ".venv/bin/python scripts/build_rq1_rq2_results.py",
    "ml:rq2-sites": ".venv/bin/python scripts/build_rq2_site_analysis.py --run=dev-cv-261025-v1.0",
    "ml:feature-mapping": ".venv/bin/python scripts/build_feature_cause_mapping.py",
    "ml:freeze": ".venv/bin/python scripts/freeze_model_v1.py --run=dev-cv-261025-v1.0",
    "ml:rq3": ".venv/bin/python scripts/run_rq3_explanations.py --run-id=rq3-testbed-261108",
    "ml:rq3-report": ".venv/bin/python scripts/build_rq3_report.py --run=rq3-testbed-261108",
    "test:ml": ".venv/bin/python -m unittest discover -s test -p 'test_*.py'"
  },
  "dependencies": {
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.8.2"
  }
}
