{
  "name": "xai-web-performance",
  "version": "0.1.0",
  "private": true,
  "description": "Detecting and explaining client-side Web performance degradation with Explainable ML",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "testbed": "node src/testbed/testbed-server.js",
    "pilot": "node src/run-pilot.js",
    "collect:wave1": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=1",
    "collect:wave2": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=2",
    "collect:wave3": "node src/run-pilot.js --scope=real --sites=config/main-study-sites.csv --wave=3",
    "sample:sites": "node scripts/build-main-study-site-sample.js",
    "reparse": "node scripts/reparse-raw-artifacts.js",
    "dictionary": "node scripts/build-data-dictionary.js",
    "reports": "npm run reparse && npm run dictionary && node scripts/build-fault-matrix-noise-report.js && node scripts/build-leakage-checklist.js && node scripts/build-dataset-qc-report.js && node scripts/build-eda-report.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.8.2"
  }
}
